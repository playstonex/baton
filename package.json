{
  "name": "baton",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source remote AI Agent orchestration platform",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.8.1",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:daemon": "pnpm --filter @baton/daemon dev",
    "lint": "eslint packages/*/src --ext .ts,.tsx",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\"",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "turbo clean"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "@types/react": "19.3.0"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "expo-modules-core>react-native-worklets": "^0.13.0"
      }
    },
    "patchedDependencies": {
      "react-native-webview@14.0.1": "patches/react-native-webview@14.0.1.patch"
    }
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3"
  }
}
